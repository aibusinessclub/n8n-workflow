    {
      "id": "2",
      "name": "Technical Terms Generator",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [220, 0],
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $credentials.openAiApi.apiKey }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "gpt-4"
            },
            {
              "name": "messages",
              "value": "=[{\"role\": \"user\", \"content\": \"Generate 5 trending technical terms for today's research. Focus on AI, blockchain, cloud computing, cybersecurity, and emerging technologies. Return as JSON array.\"}]"
            },
            {
              "name": "temperature",
              "value": "0.7"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "3",
      "name": "Parse Technical Terms",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 0],
      "parameters": {
        "jsCode": "// Parse OpenAI response to extract technical terms\nconst response = $input.first().json;\nconst terms = [];\n\ntry {\n  const content = JSON.parse(response.choices[0].message.content);\n  if (Array.isArray(content)) {\n    content.forEach(term => {\n      terms.push({\n        term: typeof term === 'string' ? term : term.term || term.name,\n        timestamp: new Date().toISOString()\n      });\n    });\n  }\n} catch (error) {\n  // Fallback: try to extract terms from text\n  const text = response.choices[0].message.content;\n  const matches = text.match(/\"([^\"]+)\"/g) || [];\n  matches.forEach(match => {\n    terms.push({\n      term: match.replace(/\"/g, ''),\n      timestamp: new Date().toISOString()\n    });\n  });\n}\n\nreturn terms.map(term => ({ json: term }));"
      }
    },
    {
