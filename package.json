{
  "name": "n8n-workflow-mcp",
  "version": "1.0.0",
  "description": "AI-powered n8n workflow recommendation system with semantic search and MCP server",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --minify",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "seed": "tsx scripts/seed.ts"
  },
  "keywords": [
    "n8n",
    "workflow",
    "mcp",
    "cloudflare",
    "semantic-search",
    "ai",
    "automation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.0",
    "@cloudflare/workers-types": "^4.20241127.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@types/node": "^20.10.0",
    "typescript": "^5.9.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@vitest/ui": "^1.6.1",
    "eslint": "^8.56.0",
    "prettier": "^3.1.1",
    "tsx": "^4.6.2",
    "vitest": "^1.6.1",
    "vitest-environment-miniflare": "^2.14.4",
    "wrangler": "^3.114.17"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
